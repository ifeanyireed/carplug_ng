# Server Configuration
PORT=8080
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Neon) Database Configuration
DATABASE_URL=postgresql://user:password@host/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?channel_binding=require&sslmode=require
NEON_BRANCH=production

# Or Individual PostgreSQL Parameters
DB_HOST=ep-example.c-7.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=your_password
DB_NAME=neondb
DB_SSLMODE=require

# Database Migration & Seed Configuration
AUTO_MIGRATE=false
AUTO_SEED=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=72

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_NAME=CarPlug Nigeria
BREVO_SENDER_EMAIL=verify@yourverifieddomain.com

# Paystack Payment Gateway Configuration
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
