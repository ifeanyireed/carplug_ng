# Server Configuration
PORT=8080
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL Database Configuration
DB_HOST=your_db_host_here
DB_PORT=3306
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_CHARSET=utf8mb4

# Database Migration & Seed Configuration
AUTO_MIGRATE=false
AUTO_SEED=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=72

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_NAME=CarPlug Nigeria
BREVO_SENDER_EMAIL=verify@yourverifieddomain.com

