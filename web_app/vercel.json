{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"dev\" ] || [ \"$(git rev-parse --abbrev-ref HEAD 2>/dev/null)\" = \"dev\" ] || [ \"$(git branch --show-current 2>/dev/null)\" = \"dev\" ]; then exit 0; else exit 1; fi",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
